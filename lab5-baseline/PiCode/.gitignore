# ---------------------------------------------------------------------------
# Files generated by build/createProject.sh (CMake) and by "make all".
# Paths starting with "/" are relative to this project folder, so this file
# works whether the project is its own repository or part of a larger one.
# ---------------------------------------------------------------------------

# Everything CMake and make put in build/: CMakeCache.txt, CMakeFiles/,
# Makefile, cmake_install.cmake, compile_commands.json, the Eclipse project
# files (.project, .cproject, .settings/), object files, and the executable.
/build/*

# ...except the hand-written helper scripts, which belong in the repository
# (createProject.sh, refreshProject.sh, createDocs.sh).
!/build/*.sh

# Eclipse source project created because createProject.sh sets
# CMAKE_ECLIPSE_GENERATE_SOURCE_PROJECT=TRUE.
/src/.project

# Doxyfile generated from docs/Doxyfile.in when CMake configures the project.
# (Doxyfile.in and readme.txt are kept.)
/docs/Doxyfile

# Profiling output written when a program built with -pg is run.
gmon.out
